{
  "name": "mapwisefox-web-frontend",
  "private": true,
  "version": "0.8.1-dev1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
