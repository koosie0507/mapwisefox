{% extends "_base.j2" %}

{% block page_title %}Survey List{% endblock %}
{% block head %}
    {{ super() }}
    <link rel="stylesheet" type="text/css" href="{{ url_for('assets', path="home.css") }}"/>
{% endblock %}

{% block page_header %}
    {{ super() }}
    {% if user %}<p>Welcome, {{ user.display_name or user.email }}</p>{% endif %}
    <h1>Primary Study Lists</h1>
    <form class="upload" id="upload-form" enctype="multipart/form-data">
        <input type="file" name="file" accept=".xlsx" required>
        <input type="text" name="worksheetName" value="{{ worksheet_name }}" placeholder="Worksheet name" required>
        <input type="text" name="expectedColumns" value="{{ expected_columns }}" placeholder="Expected columns (CSV)" required>
        <input type="hidden" name="decisionColumn" value="{{ decision_column }}">
        <input type="hidden" name="exclusionReasonColumn" value="{{ exclusion_reason_column }}">
        <button type="submit">Upload</button>
    </form>
    <p id="operation-status" role="status"></p>
{% endblock %}

{% block page_content %}
    <div class="file-list">
        <table>
            <thead><tr><th>File Name</th><th>Worksheet</th><th>Records</th><th>Actions</th></tr></thead>
            <tbody id="workbook-list"></tbody>
        </table>
        <p id="empty-list">No files uploaded yet.</p>
    </div>
    <script>
        const list = document.getElementById("workbook-list");
        const empty = document.getElementById("empty-list");
        const operationStatus = document.getElementById("operation-status");

        async function loadWorkbooks() {
            const response = await fetch("/api/v1/workbooks");
            if (!response.ok) {
                operationStatus.textContent = "Could not load workbooks.";
                return;
            }
            const workbooks = await response.json();
            list.replaceChildren(...workbooks.map(workbookRow));
            empty.hidden = workbooks.length > 0;
        }

        function workbookRow(workbook) {
            const row = document.createElement("tr");
            const name = document.createElement("td");
            const worksheet = document.createElement("td");
            const count = document.createElement("td");
            const actions = document.createElement("td");
            const edit = document.createElement("a");
            const remove = document.createElement("button");
            name.textContent = workbook.name;
            worksheet.textContent = workbook.worksheetName;
            count.textContent = workbook.recordCount;
            edit.textContent = "Edit";
            edit.href = `/evidence/${encodeURIComponent(workbook.name)}`;
            remove.textContent = "Delete";
            remove.type = "button";
            remove.addEventListener("click", () => deleteWorkbook(workbook.name));
            actions.append(edit, " ", remove);
            row.append(name, worksheet, count, actions);
            return row;
        }

        async function deleteWorkbook(name) {
            const response = await fetch(`/api/v1/workbooks/${encodeURIComponent(name)}`, {method: "DELETE"});
            operationStatus.textContent = response.ok ? "Workbook deleted." : "Could not delete workbook.";
            if (response.ok) await loadWorkbooks();
        }

        document.getElementById("upload-form").addEventListener("submit", async event => {
            event.preventDefault();
            operationStatus.textContent = "Uploading...";
            const response = await fetch("/api/v1/workbooks", {method: "POST", body: new FormData(event.target)});
            if (response.ok) {
                operationStatus.textContent = "Workbook imported.";
                await loadWorkbooks();
                return;
            }
            const body = await response.json();
            operationStatus.textContent = body.detail?.message || body.detail || "Could not import workbook.";
        });

        loadWorkbooks();
    </script>
{% endblock %}
